    public function reviews()
    {
        // Load the model
        $reviewModel = new ReviewModel();
        $perPage = 10;
        $reviews = $reviewModel->where('status', 1)->paginate($perPage, 'reviews');
        $pager = $reviewModel->pager;
        $data['reviews'] = $reviews;
        $data['pager'] = $pager;
