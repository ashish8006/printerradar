RewriteEngine On

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect specific URLs if the request method is not POST
#RewriteCond %{REQUEST_URI} ^/(resolution-center|understanding-the-issue|user-detail|resolution-and-troubleshooting|thank-you)$ [NC]
#RewriteCond %{REQUEST_METHOD} !POST
#RewriteRule ^ / [L,R=302]

# Rewrite all other requests to the public folder, excluding requests to the public folder itself
RewriteRule ^((?!public/).*)$ public/$1 [L,NC]
